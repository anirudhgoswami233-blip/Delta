# OpenF1 Community tier needs NO key. Leave this unset and historical data
# (2023 onward) works immediately. Set it only for the Sponsor tier, which is
# what unlocks the live window and the streaming transports.
# OPENF1_API_KEY=

# Permanent cache. Defaults to backend/.apex-cache whatever folder the server
# is started from. A session is cached for good this many hours after it ends;
# empty answers are re-checked after APEX_EMPTY_RETRY_HOURS.
# APEX_CACHE_DIR=
# APEX_SETTLE_HOURS=24
# APEX_EMPTY_RETRY_HOURS=24
# APEX_CORS_ORIGINS=http://localhost:3000

# Browser origins also allowed by pattern: every deployment and branch address
# of a Vercel project, which an exact list cannot name in advance.
# APEX_CORS_ORIGIN_REGEX='https://delta(-[a-z0-9-]+)?-your-team\.vercel\.app'

# Gemma via LM Studio (server-side only). Also reads the workspace .env.
# GEMMA_TOKEN=
# GEMMA_BASE_URL=http://127.0.0.1:1234/v1
# GEMMA_MODEL=google/gemma-4-26b-a4b
# GEMMA_TIMEOUT_SECONDS=180
# For a remote backend, set GEMMA_BASE_URL to your HTTPS tunnel URL + /v1.

# Agent tab: folders written by the openf1 race agent (openf1-race), comma-separated.
# DELTA_RACE_AGENT_DIRS=~/openf1/.data/race-agent,~/openf1/.data/race-agent-replay
# DELTA_RACE_AGENT_URL=http://127.0.0.1:8010
# DELTA_OPENF1_DIR=~/openf1
